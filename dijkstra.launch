<launch>

  <node
    pkg="dijkstra_planner"
    type="dijkstra_node.py"
    name="dijkstra_path_planner"
    output="screen">

    <param name="grid_width" value="20"/>

    <param name="grid_height" value="20"/>

    <param name="cell_size" value="0.5"/>

    <param name="start_x" value="1"/>

    <param name="start_y" value="1"/>

    <param name="goal_x" value="18"/>

    <param name="goal_y" value="18"/>

    <param name="animation_rate" value="10.0"/>

    <param name="show_distance_labels" value="true"/>

  </node>

  <node
    pkg="rviz"
    type="rviz"
    name="dijkstra_rviz"
    args="-d $(find dijkstra_planner)/rviz/dijkstra.rviz"
    required="false"/>

</launch>
